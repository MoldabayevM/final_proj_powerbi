	column Маршруты = CONCATENATE(bikeshare_trips[start_station_name], CONCATENATE( " - ", bikeshare_trips[end_station_name]))
		lineageTag: aa7382bc-4c25-418f-ac59-fc6fd6afeb1f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Возраст =
			
			VAR age = YEAR( bikeshare_trips[start_date] ) - bikeshare_trips[member_birth_year]
			RETURN
			    IF(
			        ISBLANK( bikeshare_trips[member_birth_year] ) || age < 16 || age > 80,
			        BLANK(),
			        age
			    )
		formatString: 0
		lineageTag: eeb2661c-c9e6-4e62-af59-6b1b948a4f8c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Возрастная группа' =
			
			SWITCH(
			    TRUE(),
			    ISBLANK( bikeshare_trips[Возраст] ), "Нет данных",
			    bikeshare_trips[Возраст] < 25, "до 25",
			    bikeshare_trips[Возраст] < 35, "25–34",
			    bikeshare_trips[Возраст] < 45, "35–44",
			    bikeshare_trips[Возраст] < 55, "45–54",
			    "55+"
			)
		lineageTag: 7ea7d15c-9409-497f-829f-1ef1b70b2d4e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition bikeshare_trips = m
		mode: import
		source =
