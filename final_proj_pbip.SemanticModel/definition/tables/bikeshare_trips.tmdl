				    bikeshare_trips_Table = san_francisco_bikeshare_Schema{[Name="bikeshare_trips",Kind="Table"]}[Data],
				    #"Удаленные столбцы" = Table.RemoveColumns(bikeshare_trips_Table,{"zip_code", "c_subscription_type"}),
				    #"Дублированный столбец" = Table.DuplicateColumn(#"Удаленные столбцы", "start_date", "Копия start_date"),
				    #"Измененный тип" = Table.TransformColumnTypes(#"Дублированный столбец",{{"Копия start_date", type date}}),
				    #"Переименованные столбцы" = Table.RenameColumns(#"Измененный тип",{{"Копия start_date", "trip_day"}})
				in
				    #"Переименованные столбцы"

